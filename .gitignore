# ==========================================
*.jpg
*.jpeg
*.png
*.JPG
*.JPEG
*.PNG
*.bmp
*.tiff
*.webp

# ==========================================
# NumPy Arrays & Cached Datasets
# ==========================================
*.npy
*.npz

# ==========================================
# Model Weights (Keep only single canonical production checkpoint)
# ==========================================
models/*.h5
models/*.keras
models/*.pt
models/*.pth
ml_pipeline/models/*.keras
ml_pipeline/models/*.pt
ml_pipeline/models/*.pth

# Whitelist the canonical trained weights needed for backend inference
!ml_pipeline/models/best_model.h5

# ==========================================
# Clinical Export Reports & Generated Artifacts
# ==========================================
KidneyAI_Report_*.txt
*Report*.txt
report_*.pdf
report_*.txt

